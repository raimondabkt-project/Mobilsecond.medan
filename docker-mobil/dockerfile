# Base image Python
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Copy requirements.txt
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy semua file project
COPY . .

# Expose port 5000
EXPOSE 5000

# Jalankan Flask (development mode)
CMD ["python", "app.py"]